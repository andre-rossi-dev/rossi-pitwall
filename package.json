{
  "name": "rossi-pitwall",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "ROSSI Pitwall V0.2A: simulador e diagnóstico de recepção UDP.",
  "main": "out/main/index.js",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:smoke": "electron-vite preview --skipBuild --entry scripts/smoke.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
